<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pot.PotFragment">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignParentTop="true" android:orientation="vertical"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
        <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="#ffffff"
            android:stretchColumns="*">
            <TableRow android:background="#3e37a6">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_span="3"
                    android:layout_weight="0.2"
                    android:background="#3e37a6"
                    android:gravity="center"
                    android:fontFamily="sans-serif"
                    android:text="Week-Year Month Date"
                    android:textColor="#ffff"
                    android:textSize="30sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView android:background="#3e37a6" android:textSize="14sp" android:id="@+id/txtSummary"
                    android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_weight="0.7"
                    android:layout_height="40dp" android:gravity="bottom" android:layout_span="4"/>
            </TableRow>
            <TableRow android:background="#000000">
            </TableRow>
            <TableRow android:background="#80ffff">
                <TextView android:background="#000000" android:textSize="4dp" android:id="@+id/txtSeparator"
                    android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="wrap_content" android:gravity="center" android:layout_span="4"/>
            </TableRow>
        </TableLayout>
        <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#000000" android:stretchColumns="*">
            <TableRow>
                <TextView android:id="@+id/SAVDIFF" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf236"
                    />
                <TextView android:id="@+id/SIPDIFF" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\ue061"
                    />
                <TextView android:id="@+id/FNODIFF" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf063"
                    />
                <TextView android:id="@+id/POLDIFF" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf70c"
                    />
                <TextView android:id="@+id/CRPDIFF" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf2a2"
                    />
                <TextView android:id="@+id/SAV" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf236"
                    />
                <TextView android:id="@+id/SIP" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\ue061"
                    />
                <TextView android:id="@+id/FNO" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf063"
                    />
                <TextView android:id="@+id/POL" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf70c"
                    />
                <TextView android:id="@+id/CRP" android:textSize="35sp" android:textColor="#1dbfc4" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="40dp" android:gravity="center" android:layout_span="4" android:fontFamily="@font/fa_solid"
                    android:text="\uf2a2"
                    />
            </TableRow>
        </TableLayout>
        <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#000000" android:stretchColumns="*">
            <TableRow>
                <Button android:layout_marginRight="2dp" android:id="@+id/savebtn" android:layout_width="30dp" android:layout_height="wrap_content" android:background="#000000" android:text="Save" />
                <Button android:layout_marginRight="2dp" android:id="@+id/loadbtn" android:layout_width="30dp" android:layout_height="wrap_content" android:background="@drawable/button_orange" android:text="Load"/>
                <Button android:layout_marginRight="2dp" android:id="@+id/prevbtn" android:layout_width="30dp" android:layout_height="wrap_content" android:background="@drawable/button_red" android:text="Prev"/>
                <TextView android:id="@+id/month_date" android:textSize="15sp" android:textColor="#ff0000" android:layout_width="wrap_content" android:layout_weight="0.8"
                    android:layout_height="50dp" android:gravity="center" android:layout_span="1" android:padding="0dp"
                    android:text="Enter the Date" android:fontFamily="sans-serif"
                    android:width="20sp"
                    />
                <Button android:layout_marginRight="2dp" android:id="@+id/nextbtn" android:layout_width="30dp" android:layout_height="wrap_content" android:background="@drawable/button_blue" android:text="Next"/>
            </TableRow>
        </TableLayout>
        <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#000000" android:stretchColumns="*">
            <TableRow>
                <TextView android:layout_marginRight="8dp"/>
            </TableRow>
        </TableLayout>
        <TableLayout android:layout_width="300dp" android:layout_height="wrap_content" android:background="#000000" android:stretchColumns="*">
            <TextView
                android:id="@+id/textHome"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:layout_weight="0.8"
                android:gravity="center"
                android:text="\uf04a"
                android:textColor="#1dbfc4"
                android:textSize="10sp" />
        </TableLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>